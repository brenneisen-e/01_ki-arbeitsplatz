# Kapitel 05 Technologie / IT — "SDLC AI-Platform"
VITE_DEMO_SDLC_URL=

# Hinweis: Kapitel 02 (Vertriebscockpit) nutzt die bereits deployte Live-Demo
# und braucht keine ENV-Variable.
