/*
  X-Frame-Options: ALLOWALL
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(self), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.tailwindcss.com https://esm.sh https://api.openai.com; worker-src 'self' blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https: blob:; connect-src 'self' https://api.openai.com https://api.anthropic.com https://speech.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://esm.sh https://*.workers.dev https://api.maptiler.com https://api.mapbox.com https://*.tiles.mapbox.com https://events.mapbox.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://*.basemaps.cartocdn.com; frame-src 'self' https://*.pages.dev;

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Galerie: nie cachen, nie indexieren — sie wird laufend gepflegt.
/11_galerie/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow

/csv-generator.html
  Cache-Control: public, max-age=0, must-revalidate
